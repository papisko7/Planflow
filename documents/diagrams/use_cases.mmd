---
title: PlanFlow - Use case diagram, overview (packages of use cases per actor)
---
flowchart LR
    guest(["<b>Guest</b><br/>not signed in"]):::actor
    user(["<b>User</b><br/>signed in"]):::actor
    member(["<b>Team member</b><br/>also a User"]):::actor
    admin(["<b>Team admin</b><br/>also a Team member"]):::actor
    owner(["<b>Team owner</b><br/>also a Team admin"]):::actor
    scheduler(["<b>Scheduler</b><br/>timers in the API"]):::actor
    google(["<b>Google</b><br/>Calendar, Tasks, OAuth"]):::external
    smtp(["<b>SMTP server</b>"]):::external
    expo(["<b>Expo push service</b>"]):::external

    subgraph system ["PlanFlow system"]
        direction TB
        signin["<b>Sign in</b><br/>register, log in, reset password"]:::pkg
        account["<b>Account settings</b><br/>profile, password, PIN, sharing level, e-mail verification"]:::pkg
        items["<b>Tasks and events</b><br/>create, edit, delete, repeat, remind, lists, bulk actions"]:::pkg
        views["<b>Prioritisation and views</b><br/>ranked dashboard, item details with score explanation, calendar"]:::pkg
        notif["<b>Notifications</b><br/>inbox, preferences, push on this device"]:::pkg
        gint["<b>Google integration</b><br/>connect, sync now, disconnect"]:::pkg
        teamwork["<b>Team work</b><br/>teams, availability and workload, teammate's calendar, mute, leave"]:::pkg
        chat["<b>Team chat (optional)</b><br/>history, messages, typing and presence"]:::pkg
        adminfn["<b>Team administration</b><br/>team settings, members, assignments, any member's items"]:::pkg
        ownerfn["<b>Owner only</b><br/>promote or demote an admin, delete team"]:::pkg
        auto["<b>Automatic functions</b><br/>rescoring, alerts, reminders, repeats, delivery, cleanup"]:::pkg
    end

    guest --- signin
    user --- account
    user --- items
    user --- views
    user --- notif
    user --- gint
    member --- teamwork
    member --- chat
    admin --- adminfn
    owner --- ownerfn
    scheduler --- auto
    gint --- google
    auto --- smtp
    auto --- expo

    classDef actor fill:#08427b,stroke:#052e56,color:#fff
    classDef external fill:#999,stroke:#6b6b6b,color:#fff
    classDef pkg fill:#fff,stroke:#438dd5,color:#000
    style system fill:none,stroke:#444,stroke-dasharray:5 5
